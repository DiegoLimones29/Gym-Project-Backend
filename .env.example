DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=gym_db
DB_SSL=false
DB_SCHEMA=public
DB_SYNCHRONIZE=true
# Optional for cloud deployment (overrides DB_HOST/PORT/USERNAME/PASSWORD/NAME):
# DATABASE_URL=
# Optional direct non-pooled Postgres URL for LISTEN/NOTIFY (e.g. Neon/Supabase):
# REALTIME_DATABASE_URL=

JWT_SECRET=replace-with-shared-jwt-secret
JWT_EXPIRES_IN=1d

USERS_SERVICE_URL=http://localhost:3001
USERS_SERVICE_TIMEOUT_MS=45000
INTERNAL_API_KEY=replace-with-shared-internal-api-key
CORS_ORIGIN=http://localhost:5173

PORT=3000
